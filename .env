# Backend API URL - RMS_API_Altaire Configuration
# Local development: Single port 8080 (NestJS monorepo serves all APIs)
REACT_APP_API_URL=http://localhost:8080

# Production: Separate microservice URL for events
# REACT_APP_API_URL=https://dev-events-api.rms.ac.ae

# Other environment variables
REACT_APP_ENV=development

# Default shop slug - bare "/" redirects to /<slug>/login
REACT_APP_DEFAULT_SHOP_SLUG=Fixit-Kochi
